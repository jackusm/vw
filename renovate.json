{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "rebaseWhen": "conflicted",
    "automergeType": "pr",
    "platformAutomerge": true,
    "dependencyDashboard": true,
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["ghcr.io/dani-garcia/vaultwarden"],
            "addLabels": ["vaultwarden-update"]
        },
        {
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "automerge": true,
            "minimumReleaseAge": "3 days"
        },
        {
            "matchManagers": ["github-actions"],
            "matchDepNames": ["flyctl"],
            "automerge": true,
            "automergeType": "branch",
            "ignoreTests": true,
            "minimumReleaseAge": "3 days"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^vaultwarden-fly-io/Dockerfile$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
            ]
        }
    ]
}
